# RShield AI - Environment Configuration

PORT=5000

# Google Gemini API Key (Backend-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google Safe Browsing API Key (v4)
GOOGLE_SAFE_BROWSING_KEY=

# Google OAuth / Client Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Cloud Database (Optional - syncs session and scan count metrics to Supabase)
SUPABASE_URL=
SUPABASE_KEY=

# Rate Limiter Window (Max requests per 15 minutes per IP)
RATE_LIMIT_MAX=60
